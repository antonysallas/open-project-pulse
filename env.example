# Settings for `node server/server.js`, read from a file named .env next to
# package.json, or from the environment. All are optional: with nothing set, Pulse
# has no sign-in and listens only on this computer. See docs/sign-in.md.

# on: every request needs a user from your sign-in proxy. off: no sign-in.
PULSE_AUTH=off

# Where your sign-in proxy signs people in and out.
# PULSE_AUTH_SIGN_IN_URL=/oauth2/start
# PULSE_AUTH_SIGN_OUT_URL=/oauth2/sign_out

# Minutes without activity before signing out, when sign-in is on.
# PULSE_IDLE_MINUTES=25

# The address to listen on. Anything but this computer needs PULSE_AUTH=on.
# PULSE_HOST=127.0.0.1

# The address people reach Pulse at. A POST from any other site is refused.
# PULSE_ORIGIN=https://pulse.example.com

# PULSE_PORT=4070
# PULSE_DATA=/path/to/data
