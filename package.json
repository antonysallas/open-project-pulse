{
  "name": "open-project-pulse",
  "version": "0.1.0",
  "description": "Weekly project status reports: a few minutes of typing, a two-page report for stakeholders.",
  "license": "GPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/antonysallas/open-project-pulse.git"
  },
  "bin": {
    "pulse": "bin/pulse.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "^16.18.64",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "html2canvas": "1.4.1",
    "jspdf": "3.0.2",
    "lucide-react": "1.49.0",
    "nth-check": "^2.1.1",
    "postcss": "^8.4.32",
    "pptxgenjs": "3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "PORT=3010 NODE_OPTIONS=--no-deprecation GENERATE_SOURCEMAP=false react-scripts start",
    "build": "GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false react-scripts build",
    "serve": "node server/server.js",
    "package": "sh scripts/package-release.sh",
    "test": "react-scripts test",
    "test:server": "node --test server/*.test.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.32",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-transform-private-methods": "^7.23.3",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-optional-chaining": "^7.23.4",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.23.4",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-transform-numeric-separator": "^7.23.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.23.4"
  },
  "resolutions": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.32"
  },
  "devDependencies": {
    "@types/jest": "27.5.2",
    "ajv": "^8.20.0"
  }
}
